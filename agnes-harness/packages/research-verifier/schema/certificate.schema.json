{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnes.dev/schemas/research-verifier/certificate-v1.json",
  "title": "Research verification certificate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "claim", "instance", "witness", "evidence"],
  "properties": {
    "schema_version": { "const": 1 },
    "claim": { "$ref": "#/$defs/claim" },
    "instance": { "$ref": "#/$defs/instance" },
    "witness": { "$ref": "#/$defs/witness" },
    "evidence": { "type": "array", "items": { "$ref": "#/$defs/evidence" } },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/assumption" } },
    "ruleset_checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  },
  "$defs": {
    "claim": { "type": "object", "required": ["id", "text", "kind"], "properties": { "id": { "type": "string", "minLength": 1 }, "text": { "type": "string" }, "kind": { "type": "string", "minLength": 1 }, "scope": { "type": "object" } }, "additionalProperties": false },
    "instance": { "type": "object", "required": ["dataset_version_id", "dataset_checksum", "analysis_spec_checksum", "assumption_ids"], "properties": { "dataset_version_id": { "type": "string", "minLength": 1 }, "dataset_checksum": { "$ref": "#/$defs/checksum" }, "analysis_spec_checksum": { "$ref": "#/$defs/checksum" }, "assumption_ids": { "type": "array", "items": { "type": "string" } } }, "additionalProperties": false },
    "witness": { "type": "object", "required": ["source_code_version_id", "execution_id", "input_version_ids", "output_version_ids", "environment_fingerprint", "result_fields"], "properties": { "source_code_version_id": { "type": "string", "minLength": 1 }, "execution_id": { "type": "string", "minLength": 1 }, "input_version_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "output_version_ids": { "type": "array", "items": { "type": "string" }, "minItems": 1 }, "environment_fingerprint": { "$ref": "#/$defs/checksum" }, "result_fields": { "type": "array", "items": { "$ref": "#/$defs/result_field" } } }, "additionalProperties": false },
    "result_field": { "type": "object", "required": ["path", "value"], "properties": { "path": { "type": "string", "minLength": 1 }, "value": {} }, "additionalProperties": false },
    "evidence": { "type": "object", "required": ["kind", "ref", "checksum"], "properties": { "kind": { "enum": ["ledger-event", "artifact-version", "receipt"] }, "ref": { "type": "string", "minLength": 1 }, "checksum": { "$ref": "#/$defs/checksum" }, "coverage": { "enum": ["available", "partial", "unavailable"] } }, "additionalProperties": false },
    "assumption": { "type": "object", "required": ["id", "statement", "required_for", "observable_checks", "status", "evidence_refs"], "properties": { "id": { "type": "string" }, "statement": { "type": "string" }, "required_for": { "type": "array", "items": { "type": "string" } }, "observable_checks": { "type": "array", "items": { "type": "string" } }, "status": { "enum": ["satisfied", "violated", "unknown", "not-applicable"] }, "evidence_refs": { "type": "array", "items": { "type": "string" } }, "unknown_reason": { "type": "string" }, "severity": { "enum": ["warning", "error"] } }, "additionalProperties": false },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
