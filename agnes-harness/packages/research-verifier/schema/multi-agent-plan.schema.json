{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agnes.local/schemas/research-verifier/multi-agent-plan.schema.json",
  "title": "Research verifier multi-agent plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "plan_id", "run_id", "root_agent_id", "agents", "tasks", "checksum"],
  "properties": {
    "schema_version": { "const": 1 },
    "plan_id": { "type": "string", "minLength": 1 },
    "run_id": { "type": "string", "minLength": 1 },
    "root_agent_id": { "type": "string", "minLength": 1 },
    "checksum": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "agents": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["agent_id", "role", "revision", "capabilities"],
        "properties": {
          "agent_id": { "type": "string", "minLength": 1 },
          "role": { "enum": ["planner", "executor", "reviewer", "verifier"] },
          "revision": { "type": "string", "minLength": 1 },
          "capabilities": { "type": "array", "items": { "type": "string" } },
          "runtime": { "type": "string" },
          "trust": { "enum": ["trusted", "untrusted"] }
        }
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "agent_id", "mode", "output_namespace"],
        "properties": {
          "task_id": { "type": "string", "minLength": 1 },
          "agent_id": { "type": "string", "minLength": 1 },
          "mode": { "enum": ["serial", "parallel"] },
          "depends_on": { "type": "array", "items": { "type": "string" } },
          "input_artifact_ids": { "type": "array", "items": { "type": "string" } },
          "output_namespace": { "type": "string", "minLength": 1 },
          "budget": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "credits": { "type": "number", "minimum": 0 },
              "max_steps": { "type": "integer", "minimum": 1 },
              "timeout_ms": { "type": "integer", "minimum": 1 }
            }
          }
        }
      }
    }
  }
}
